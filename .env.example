# At least 32 random characters; signs player sessions.
JWT_SECRET=replace-with-at-least-32-random-characters
# MongoDB connection string (free Atlas M0 cluster). Leave empty for guest-only play,
# or use memory://test for a throwaway in-memory database while developing.
MONGODB_URI=memory://test
# Websites allowed to call the API (comma-separated). In production an empty value means
# only this service's own address; the Android app's local web view is always allowed.
ALLOWED_ORIGINS=http://localhost:3000
# Optional: 12+ characters to switch on admin mode.
ADMIN_KEY=
PORT=3000
NODE_ENV=development
